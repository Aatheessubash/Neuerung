# ==============================================================================
# Neuerung Web Application - Environment Configuration Template
# ==============================================================================
# For local testing, copy this file to .env and configure your variables.
# For Vercel production, enter these variables in the Vercel Project Dashboard (neuerung).
# DO NOT commit real passwords or production secrets to Git.
# ==============================================================================

# ─── HostGuy / cPanel SMTP Configuration (Server-Side Only) ────────────────────
SMTP_HOST=mail.neuerung.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=healthtech@neuerung.in
SMTP_PASS=your_cpanel_email_password_here
MAIL_FROM="Neuerung HealthTech" <healthtech@neuerung.in>
CONTACT_RECEIVER_EMAIL=healthtech@neuerung.in

# ─── Local Development Server ───────────────────────────────────────────────────
PORT=5000

# ─── Optional Frontend Base URL (Client-Side) ──────────────────────────────────
# Leave empty for relative path `/api/contact` on Vercel
# VITE_API_URL=

